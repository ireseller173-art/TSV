rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload their own files
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.uid == userId && request.resource.size < 50 * 1024 * 1024;
    }

    // Allow users to upload chat media
    match /chats/{chatId}/{allPaths=**} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.uid != null && request.resource.size < 100 * 1024 * 1024;
    }

    // Allow users to upload group media
    match /groups/{groupId}/{allPaths=**} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.uid != null && request.resource.size < 100 * 1024 * 1024;
    }

    // Allow users to upload avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.uid == userId && request.resource.size < 10 * 1024 * 1024;
    }

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
